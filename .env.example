# cHack Configuration Template
# Central Backend & Telegram Bot Configuration
BACKEND_URL=https://your-backend.workers.dev
GRAPHQL_ENDPOINT=https://your-backend.workers.dev/graphql
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# ADMIN_IDS = comma-separated Telegram user IDs treated as SUPERADMINS (full
# access; can grant roles/team scopes). Empty = legacy wide-open single-tenant.
ADMIN_IDS=your_telegram_user_id
RUNNER_NAME=VPS-1

# --- Team workflows & multi-user auth (optional) ---
# Shared secret each runner sends to the central queue. When set here AND as the
# worker's RUNNER_TOKEN binding, the backend rejects runners that don't present it.
# Leave blank to keep the queue open (backward compatible).
RUNNER_TOKEN=

# Set the worker binding AUTH_ENFORCED=true (wrangler vars/secret, not here) to
# require an API-token Bearer for team-workflow GraphQL mutations. Mint tokens
# with the createApiToken mutation while enforcement is still off (bootstrap),
# then flip it on. Roles: admin > member > viewer (runner = result push only).

# Database Configuration:
# cHack relies entirely on local SQLite (local.db) and synchronizes with Cloudflare D1.
# No PostgreSQL or external DB installation is required.

# Shared secret authenticating VPS runners to the Cloudflare Worker.
# Must match the Worker's RUNNER_TOKEN (set via: wrangler secret put RUNNER_TOKEN).
# Generate one with: openssl rand -hex 32
RUNNER_TOKEN=your_shared_runner_token

# --- BYOK AI Assistant (optional; see ai_assistant.py) ---
# Bring-your-own-key triage layer over your own stored scan data. Nothing
# here is required to run cHack's scans — only `--ai-review` / `--ai-history`.
# AI_PROVIDER: anthropic (default) | openai | generic (any OpenAI-compatible
# endpoint, e.g. a local model server — set AI_BASE_URL for it).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Path to your own knowledge-base repo (vuln methodology notes), used by
# skills that set requires_kb: true when run with --ai-kb. Expects a
# Vulns/<Name>.md note per vuln class, matching ai_assistant.py's
# VULN_TYPE_TO_KB_NOTE mapping.
AI_KB_PATH=
