# Cloudflare Worker local secrets — copy to back/.dev.vars and fill in.
# back/.dev.vars is git-ignored; NEVER commit real tokens.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# ADMIN_IDS = comma-separated Telegram user IDs that are SUPERADMINS. They always
# have full access and can grant roles (/role) and team scopes (/grant) to others.
# Leave EMPTY only for a single-tenant/dev setup: an empty ADMIN_IDS opens the bot
# to everyone (legacy behaviour). With any value set, everyone else starts as
# 'pending' and must be granted a role by a superadmin before they can use it.
ADMIN_IDS=your_telegram_user_id,another_admin_id
RUNNERS=VPS-1,VPS-2

# Shared secret authenticating runners + GraphQL/DB control plane.
# Generate: openssl rand -hex 32  (prod: wrangler secret put RUNNER_TOKEN)
RUNNER_TOKEN=your_shared_runner_token

# Optional: Telegram webhook secret_token. When set, /webhook rejects requests
# whose X-Telegram-Bot-Api-Secret-Token header does not match.
# Register it with setWebhook(secret_token=...). Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# Optional: this Worker's public https URL (e.g. https://chack-back.<acct>.workers.dev).
# Used to build the Telegram Mini App button/URL (/app). Falls back to
# GRAPHQL_ENDPOINT's origin when unset. Telegram requires https, so the Mini App
# button is hidden for local http dev.
PUBLIC_URL=https://your-worker.workers.dev
